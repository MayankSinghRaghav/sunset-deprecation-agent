# Copy to .env and fill in. .env is gitignored and must never be committed.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# The bootstrap script creates a cluster on a non-standard port so it cannot
# collide with a system Postgres.
SUNSET_PGPORT=54329
SUNSET_PGHOST=127.0.0.1

# The application connects as sunset_app, which is REVOKE'd from the `truth`
# schema. This is the primary ground-truth isolation mechanism — do not point
# the app at a superuser role.
SUNSET_DATABASE_URL=postgresql+psycopg://sunset_app:sunset_app@127.0.0.1:54329/sunset

# The scoring harness — and ONLY the scoring harness — connects as sunset_eval.
SUNSET_EVAL_DATABASE_URL=postgresql+psycopg://sunset_eval:sunset_eval@127.0.0.1:54329/sunset

# ---------------------------------------------------------------------------
# LLM provider
# ---------------------------------------------------------------------------
# offline : deterministic rule-table stub. No key, no network. Runs everything,
#           but eval/score.py will REFUSE to print an accuracy headline.
# replay  : committed cassettes, keyed by request hash. A miss is a hard error.
# live    : real Gemini calls. Requires GEMINI_API_KEY.
SUNSET_LLM_MODE=offline

# Get one at https://aistudio.google.com/apikey — free tier is sufficient.
# Leave blank for offline/replay.
GEMINI_API_KEY=

SUNSET_MODEL_AUDITOR=gemini-2.5-flash
SUNSET_MODEL_COMPOSER=gemini-2.5-flash
SUNSET_EMBEDDING_MODEL=text-embedding-004

# ---------------------------------------------------------------------------
# Retrieval
# ---------------------------------------------------------------------------
# pgvector : HNSW index via the vector extension.
# numpy    : brute-force cosine in Python. ~1,500 vectors, sub-millisecond.
#            The bootstrap script sets this automatically if pgvector won't install.
SUNSET_VECTOR_BACKEND=pgvector

# ---------------------------------------------------------------------------
# Budget
# ---------------------------------------------------------------------------
# Spec §9.3 target: one full 40-feature run under 150K tokens. Exceeding this
# raises rather than silently truncating evidence — truncating evidence to hit
# a round number is how you manufacture a catastrophic error.
SUNSET_TOKEN_BUDGET=150000
SUNSET_MAX_CONCURRENCY=4
